{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ALH Current Learner State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "learner_id",
    "state_version",
    "learner_state"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_type": {
      "const": "current_learner_state"
    },
    "learner_id": {
      "type": "string",
      "pattern": "^learner-[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "state_version": {
      "type": "integer",
      "minimum": 0
    },
    "learner_state": {
      "$ref": "#/$defs/learnerState"
    }
  },
  "$defs": {
    "learnerState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "competencies": {
          "$ref": "#/$defs/competencyMap"
        },
        "learning_debt": {
          "$ref": "#/$defs/learningDebtMap"
        },
        "automation_levels": {
          "$ref": "#/$defs/automationLevelMap"
        },
        "educational_done": {
          "$ref": "#/$defs/educationalDoneMap"
        }
      }
    },
    "competencyMap": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": ".*\\S.*"
      },
      "additionalProperties": {
        "type": "string",
        "enum": ["unknown", "introduced", "learning", "practicing", "mastered"]
      }
    },
    "learningDebtMap": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": ".*\\S.*"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "automationLevelMap": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": ".*\\S.*"
      },
      "additionalProperties": {
        "type": "string",
        "enum": ["NONE", "ASSISTED", "SHARED", "FULL"]
      }
    },
    "educationalDoneMap": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": ".*\\S.*"
      },
      "additionalProperties": {
        "type": "boolean"
      }
    }
  }
}
