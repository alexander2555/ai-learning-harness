{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ALH Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "evidence_id",
    "evidence_type",
    "summary",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_type": {
      "const": "evidence"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^evidence-[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "evidence_type": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "project_state": {
      "type": "string",
      "minLength": 1
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "source_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidenceId"
      }
    },
    "relations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relation"
      }
    }
  },
  "$defs": {
    "evidenceId": {
      "type": "string",
      "pattern": "^evidence-[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "mechanism": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "status"],
      "properties": {
        "requested": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "not_attempted",
            "invocation_failed",
            "completed_unsuccessfully",
            "completed_successfully",
            "outcome_unknown"
          ]
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "mechanism": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string"
        },
        "failure": {
          "type": "string",
          "minLength": 1
        },
        "output_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target_evidence_id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["corrects", "supersedes", "invalidates"]
        },
        "target_evidence_id": {
          "$ref": "#/$defs/evidenceId"
        }
      }
    }
  }
}
